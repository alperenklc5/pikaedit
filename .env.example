# Public base URL of the deployment (no trailing slash). Used for canonical
# URLs, the short links returned by /api/shorten and the /go fallback pages.
# If unset, the code falls back to https://pikaedit.com.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: how often the scheduled cleanup runs, in milliseconds.
# Default 300000 (5 minutes).
# CLEANUP_INTERVAL_MS=300000

# Optional: age in milliseconds after which files in data/temp
# (partial uploads) are removed. Default 1800000 (30 minutes).
# CLEANUP_TEMP_MAX_AGE_MS=1800000
